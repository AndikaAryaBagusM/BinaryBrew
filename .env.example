# Copy to .env and fill in. Never commit .env.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# App connection (matches docker-compose.yml)
DATABASE_URL=postgres://binarybrew:binarybrew_dev@localhost:5432/binarybrew
# Integration tests use a separate database
TEST_DATABASE_URL=postgres://binarybrew:binarybrew_dev@localhost:5432/binarybrew_test

# Used in QR codes and receipts. Set to the PC's LAN address to test on phones,
# e.g. http://192.168.1.20:3000
APP_BASE_URL=http://localhost:3000

# Peppers session/device token hashes: 32+ random bytes as hex (64+ characters)
TOKEN_HASH_PEPPER=

# mock until a real gateway adapter exists (Phase 4)
PAYMENT_PROVIDER=mock
# Signs/verifies webhook payloads: 32+ random bytes as hex (64+ characters)
PAYMENT_WEBHOOK_SECRET=

# Used by db:seed only (local development)
SEED_OWNER_EMAIL=owner@binarybrew.local
SEED_OWNER_PASSWORD=
SEED_OWNER_PIN=

# Process timezone
TZ=Asia/Jakarta
