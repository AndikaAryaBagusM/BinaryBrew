{
  "name": "binary-brew",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:reco": "tsx scripts/reco.ts test",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed/index.ts",
    "seed:orders": "tsx scripts/generate-seed-orders.ts",
    "import:orders": "tsx scripts/import-orders-csv.ts",
    "reco:setup": "tsx scripts/reco.ts setup",
    "reco:run": "tsx scripts/reco.ts run",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:reco",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.5",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "argon2": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
